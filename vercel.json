{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "python3.12@3.12.5",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/app\\.(css|js)", "dest": "/frontend/app.$1" },
    { "src": "/docs/(.*)", "dest": "/docs/$1" },
    { "src": "/((?!api|docs|app\\.|$).*)", "dest": "/frontend/index.html" }
  ]
}
